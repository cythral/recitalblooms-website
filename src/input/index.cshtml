@{
    ViewData["Title"] = "Home";
}

<div id="hero">
    <div id="slides">
        <ul>
            <li><img src='@Context.GetLink("./img/slides/slide1.jpeg")'
                         alt="Recital Blooms - Dance Studios, Fundraise with Flowers" /></li>
                <li><img src='@Context.GetLink("./img/slides/slide2.jpeg")'
                             alt="Recital Blooms - Cheer Teams, Fundraise with Flowers" /></li>
                </ul>
            </div>

            <div id="hero-overlay"></div>
        </div>

        <div id="hero-overlay-text">
            <h2>Flowers Service for Dance Recital and School Graduation</h2>
            <a class="btn" href="/contact">Contact Us</a>
        </div>

        <div class="container">
            <section id="what-is-recital-blooms">
                <img src='@Context.GetLink("./img/rosebouquet1.jpeg")' alt="Rose Boquet - Recital Blooms" />
                <div>
                    <h2>What is Recital Blooms?</h2>
                    <p>Recital Blooms is an on-site flower program designed especially for dance studios and school events.</p>

                    <p>We provide a convenient experience for your guests by offering fresh-cut, high-quality bouquets and
                        plush teddy bears available right at your event. Enhance your celebration with Recital Blooms while
                        creating memorable moments for families and performers alike.</p>



                        <p>Recital Blooms partners with dance studios and schools to provide a fully managed, premium flower
                            service. Our bouquets are available in a wide variety of colors and styles, ensuring there’s something
                            perfect for every performer.</p>



                            <p>Our service is completely hands-off for your staff. We handle everything—from professional setup and
                                on-site sales to complete cleanup—so your team can stay focused on running a successful event.</p>



                                <p>There are no minimums, no upfront costs, and no responsibilities for your staff. We manage everything
                                    from start to finish, creating a seamless and stress-free experience for both your organization and your
                                    guests.</p>
                                </p>
                            </div>
                        </section>

                        <section>
                            <div>
                                <h2>Recital Blooms?</h2>
                                <ul>
                                    <li>Convenient on-site flower services</li>
                                    <li>Fresh-cut, high-quality bouquets</li>
                                    <li>Stress-free experience for studios and schools</li>
                                    <li>Creates memorable moments for families and performers</li>
                                    <li>Fundraising opportunities for your organization</li>
                                    <li>Generate additional revenue for your institution</li>
                                    <li>Support a charitable cause with every purchase</li>
                                    <li>No upfront costs or financial risk</li>
                                    <li>No work required from your staff</li>
                                </ul>
                            </div>
                        </section>


                        <section id="fundraising-for-charity">
                            <div>
                                <h2>Fundraising</h2>
                                <p>Team up with Recital Blooms and fundraise with flowers while giving families a beautiful and convenient
                                    way
                                    to celebrate their performers. A portion of every sale also helps support one of our charitable funds,
                                    making every bouquet even more meaningful.</p>



                                    <p>A portion of every sale goes directly back to support your studio or school—turning each bouquet into a
                                        meaningful contribution.</p>



                                        <p>Zero risk. Zero hassle. No work for your team—just added value for your guests and additional revenue for
                                            your studio.</p>
                                        </div>
                                        <img src='@Context.GetLink("./img/rosebouquet4.jpeg")' alt="Rose Boquet - Recital Blooms" />
                                    </section>

                                        
                                    <section id="contact-us">
                                        <a class="btn" href="/contact">Contact Us</a>
                                    </section>
                                </div>
                            </div>
                            <script src='@Context.GetLink("./js/index.js")' type="text/javascript"></script>